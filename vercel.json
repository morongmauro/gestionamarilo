{
  "buildCommand": "echo skip-build",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/share/:token",
      "destination": "/share.html"
    },
    {
      "source": "/iniciativas",
      "destination": "/iniciativas.html"
    },
    {
      "source": "/((?!api|share|assets|iniciativas).*)",
      "destination": "/index.html"
    }
  ]
}
