{
  "buildCommand": "echo skip-build",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/share/:token",
      "destination": "/share.html"
    },
    {
      "source": "/((?!api|share|assets).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/portafolio/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
