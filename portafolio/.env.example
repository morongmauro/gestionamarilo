# ============================================================
# PORTAFOLIO · variables de entorno
# Copia este archivo como .env (local) o ponlas en la configuración
# del servicio (Azure App Service → Configuración → Variables).
# ============================================================

PORT=8080

# Clave para firmar las sesiones. Pon una cadena larga y aleatoria.
# Si no la pones, la app genera una y la guarda en la base.
SESSION_SECRET=

# Primer administrador. Se crea solo la primera vez que arranca sin usuarios.
# (Si no lo pones, la app muestra la pantalla «Crear administrador».)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# En producción, la pantalla «Crear administrador» pide este código.
SETUP_CODE=

# Nombre que se muestra en la barra lateral.
ORG_NAME=Oficina de Generación de Valor

# ------------------------------------------------------------
# BASE DE DATOS
#   DB=file → un archivo JSON (para probar en tu computador)
#   DB=sql  → SQL Server / Azure SQL / SQL database en Microsoft Fabric
#   DB=postgres → Cloud SQL para PostgreSQL (Google Cloud), Supabase, Neon…
#                 Basta con poner DATABASE_URL; las tablas se crean solas (ver DESPLIEGUE-GCP.md).
# ------------------------------------------------------------
DB=file
# Google Cloud (Cloud Run + Cloud SQL): la cadena va en Secret Manager, no aquí.
# DATABASE_URL=postgresql://USUARIO:CLAVE@/portafolio?host=/cloudsql/PROYECTO:REGION:INSTANCIA
DATA_FILE=./data/portafolio.json

SQL_SERVER=
SQL_DATABASE=
SQL_PORT=1433
# sql | service-principal | managed-identity
SQL_AUTH=sql
SQL_USER=
SQL_PASSWORD=
SQL_CLIENT_ID=
SQL_CLIENT_SECRET=
SQL_TENANT_ID=
SQL_SCHEMA=dbo
SQL_TABLE_PREFIX=pf_

# ------------------------------------------------------------
# EXPORTACIÓN PARA EL DATA LAKE
# Con esto, Data Factory / Fabric / Databricks pueden leer
#   GET /api/export/<tabla>?format=csv|json
# con el encabezado  Authorization: Bearer <EXPORT_TOKEN>
# Vacío = exportación deshabilitada (salvo para administradores con sesión).
# ------------------------------------------------------------
EXPORT_TOKEN=

# ------------------------------------------------------------
# ENVÍO DIRECTO AL DATA LAKE DE AZURE (ADLS Gen2)
# LAKE_ACCOUNT → nombre de la cuenta; la app entra con su identidad administrada
# LAKE_CONNECTION_STRING → solo para pruebas (por ejemplo, el emulador Azurite)
# ------------------------------------------------------------
LAKE_ACCOUNT=
LAKE_CONNECTION_STRING=
LAKE_CONTAINER=portafolio
LAKE_PREFIX=portafolio
LAKE_FORMAT=csv
LAKE_HOUR=2

# Zona horaria de los comités (para el archivo .ics de Outlook). Bogotá = -05:00
TZ_OFFSET=-05:00

# Rescate del administrador (solo si nadie puede entrar). Al arrancar, ese correo queda como administrador
# con esta contraseña temporal y debe cambiarla al entrar. Se aplica una vez; después borra las dos variables.
# RESCATE_CORREO=admin@empresa.com
# RESCATE_CLAVE=Temporal2026

# Correo automático para invitaciones y «¿Olvidaste tu contraseña?» (opcional, servicio Resend).
# Sin esto, el sitio muestra el enlace para que el administrador lo comparta por Teams o correo.
# RESEND_API_KEY=
# CORREO_REMITENTE=Portafolio <portafolio@tudominio.com>
# Dirección pública del sitio para los enlaces (si no, se toma de la petición)
# APP_URL=https://portafolio-gestion-de-valor.vercel.app

# ---------- Agente «Pregúntele al portafolio» ----------
# La llave de la API de Claude (se crea en console.anthropic.com). Va solo aquí o en Vercel,
# nunca en el código. Sin ella el botón «Preguntar» avisa que el agente no está activado.
# ANTHROPIC_API_KEY=
# Modelo (opcional; por defecto claude-opus-5-5)
# AGENTE_MODELO=claude-opus-5-5
# Encender el agente (además de la llave). Mientras no esté en true, responde que está en desarrollo.
# AGENTE_ACTIVO=true
