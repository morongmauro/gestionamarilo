# ============================================================
# PORTAFOLIO · variables de entorno
# Copia este archivo como .env (local) o ponlas en la configuración
# del servicio (Azure App Service → Configuración → Variables).
# ============================================================

PORT=8080

# Clave para firmar las sesiones. Pon una cadena larga y aleatoria.
# Si no la pones, la app genera una y la guarda en la base.
SESSION_SECRET=

# Primer administrador. Se crea solo la primera vez que arranca sin usuarios.
# (Si no lo pones, la app muestra la pantalla «Crear administrador».)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# En producción, la pantalla «Crear administrador» pide este código.
SETUP_CODE=

# Nombre que se muestra en la barra lateral.
ORG_NAME=Oficina de Generación de Valor

# ------------------------------------------------------------
# BASE DE DATOS
#   DB=file → un archivo JSON (para probar en tu computador)
#   DB=sql  → SQL Server / Azure SQL / SQL database en Microsoft Fabric
# ------------------------------------------------------------
DB=file
DATA_FILE=./data/portafolio.json

SQL_SERVER=
SQL_DATABASE=
SQL_PORT=1433
# sql | service-principal | managed-identity
SQL_AUTH=sql
SQL_USER=
SQL_PASSWORD=
SQL_CLIENT_ID=
SQL_CLIENT_SECRET=
SQL_TENANT_ID=
SQL_SCHEMA=dbo
SQL_TABLE_PREFIX=pf_

# ------------------------------------------------------------
# EXPORTACIÓN PARA EL DATA LAKE
# Con esto, Data Factory / Fabric / Databricks pueden leer
#   GET /api/export/<tabla>?format=csv|json
# con el encabezado  Authorization: Bearer <EXPORT_TOKEN>
# Vacío = exportación deshabilitada (salvo para administradores con sesión).
# ------------------------------------------------------------
EXPORT_TOKEN=

# Zona horaria de los comités (para el archivo .ics de Outlook). Bogotá = -05:00
TZ_OFFSET=-05:00
