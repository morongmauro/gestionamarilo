UM($B21:H21)","=SUM($B21:I21)","=SUM($B21:J21)","=SUM($B21:K21)"],"n":"cop"},{"t":"dato","c":["Acumulado maquinaria nueva","=SUM($B22:B22)","=SUM($B22:C22)","=SUM($B22:D22)","=SUM($B22:E22)","=SUM($B22:F22)","=SUM($B22:G22)","=SUM($B22:H22)","=SUM($B22:I22)","=SUM($B22:J22)","=SUM($B22:K22)"],"n":"cop"},{"t":"dato","c":["Acumulado renders","=SUM($B23:B23)","=SUM($B23:C23)","=SUM($B23:D23)","=SUM($B23:E23)","=SUM($B23:F23)","=SUM($B23:G23)","=SUM($B23:H23)","=SUM($B23:I23)","=SUM($B23:J23)","=SUM($B23:K23)"],"n":"cop"},{"t":"total","c":["ACUMULADO DE LOS PROYECTOS","=SUM($B24:B24)","=SUM($B24:C24)","=SUM($B24:D24)","=SUM($B24:E24)","=SUM($B24:F24)","=SUM($B24:G24)","=SUM($B24:H24)","=SUM($B24:I24)","=SUM($B24:J24)","=SUM($B24:K24)"],"n":"cop"},{"t":"total","c":["ACUMULADO FINAL DE LA SAS (antes de renta)","=SUM($B25:B25)","=SUM($B25:C25)","=SUM($B25:D25)","=SUM($B25:E25)","=SUM($B25:F25)","=SUM($B25:G25)","=SUM($B25:H25)","=SUM($B25:I25)","=SUM($B25:J25)","=SUM($B25:K25)"],"n":"cop"},{"t":"vacia","c":[]},{"t":"seccion","c":["FLUJO DE CAJA PARA LOS SOCIOS"]},{"t":"dato","c":["Ingreso neto después de impuestos","=B27","=C27","=D27","=E27","=F27","=G27","=H27","=I27","=J27","=K27"],"n":"cop"},{"t":"dato","c":["Aporte de capital inicial (salida de caja)","=-'Gastos SAS'!$D$9","=0","=0","=0","=0","=0","=0","=0","=0","=0"],"n":"cop","rol":"inversion"},{"t":"total","c":["Flujo de caja del año","=B37+B38","=C37+C38","=D37+D38","=E37+E38","=F37+F38","=G37+G38","=H37+H38","=I37+I38","=J37+J38","=K37+K38"],"n":"cop"},{"t":"total","c":["Flujo de caja acumulado","=SUM($B39:B39)","=SUM($B39:C39)","=SUM($B39:D39)","=SUM($B39:E39)","=SUM($B39:F39)","=SUM($B39:G39)","=SUM($B39:H39)","=SUM($B39:I39)","=SUM($B39:J39)","=SUM($B39:K39)"],"n":"cop"}],"anchos":[324,122,122,122,122,122,122,122,122,122,122]}],"flujo":{"hoja":2,"col0":1,"anios":10,"colNombre":0}},"consideraciones":"CONSIDERACIONES A TENER EN CUENTA\n\n1. ALCANCE Y BASE DEL MODELO\n• Es una proyección a 10 años. El Año 1 corresponde a 2026. Las cifras están en pesos colombianos (COP).\n• Los valores incorporan la inflación (IPC).\n• El modelo está construido con fórmulas: al modificar un dato en las hojas Supuestos o Gastos SAS, el flujo se actualiza automáticamente.\n\n2. INGRESOS\n• Maquinaria actual: ingreso a partir del avalúo de los equipos en inventario; desde el Año 2 crece 15% anual.\n• Maquinaria nueva: ingreso por arriendo de las máquinas a otros proyectos, desde el Año 2 (cifra del caso de negocio de MyE). Se ajustan con el IPC.\n• Renders: ventas base × 0,03% de visualización; desde el Año 2 crece con el IPC.\n\n3. GASTOS\n• Mantenimiento de la maquinaria actual: 10% del ingreso de la maquinaria actual de cada año.\n• Maquinaria nueva: compra de máquinas cada año desde el Año 2, (cifra del caso de negocio de MyE). Se reajusta con el IPC.\n• Renders: gasto operativo del caso de negocio de Renders; desde el Año 2 crece con el IPC.\n• Operación de la SAS: honorarios del proveedor contable y tributario según cotización; se reajustan con el IPC desde el Año 2.\n• Implementación de la SAS: gasto único del Año 1.\n• ICA: porcentaje sobre los ingresos totales del año, incluido dentro de los gastos.\n\n4. INFLACIÓN (IPC)\n• Reajuste por IPC: 6,9% en el Año 2 (2027), 4,3% en el Año 3 (2028) y 3,0% anual del Año 4 al Año 10.\n• Referencia: proyecciones de inflación del Banco de la República (informe de política monetaria de julio de 2026) y su meta de largo plazo (3%). Son estimaciones que pueden actualizarse.\n\n5. CAPITAL INICIAL\n• El aporte de capital inicial es patrimonio de los socios y no se registra como gasto. Se muestra en el flujo de caja para los socios como una salida en el Año 1.\n\n6. CÓMO SE CALCULA EL RESULTADO\n• Ingreso neto de cada proyecto = ingreso del proyecto - gastos de ese proyecto.\n• Utilidad antes de renta = ingreso neto de los proyectos - gastos de operación e implementación de la SAS - ICA.\n• Ingreso neto después de impuestos = utilidad antes de renta - impuesto de renta.\n• Los acumulados suman los valores de cada año\n\n8. CÓMO USAR EL LIBRO\n• Supuestos: tarifas de impuestos (ICA y renta), datos generales del caso e inflación.\n• Gastos SAS: gastos jurídicos, contables y operativos de la SAS (celdas amarillas).\n• Flujo 10 años: se calcula solo; no se digita."}